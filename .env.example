# Environment Configuration for InsureMithra
# Copy this file to .env and update with your actual values

# Server Configuration
NODE_ENV=development
PORT=5001

# Database
MONGODB_URI=mongodb://localhost:27017/insuremithra

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Email Configuration (for password reset and notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=InsureMithra <noreply@insuremithra.com>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5

# ============================================
# PERFORMANCE & CACHING (Epic 4 Story 1)
# ============================================

# Redis Configuration
# Leave empty to use in-memory LRU cache fallback
REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://:password@host:port/db
# For Redis Cloud: redis://:password@host:port

# Cache TTL Configuration (in seconds)
CACHE_DEFAULT_TTL=300
CACHE_POLICY_SEARCH_TTL=60
CACHE_POLICY_DETAIL_TTL=300
CACHE_USER_PURCHASES_TTL=30
CACHE_USER_CLAIMS_TTL=30

# Compression
ENABLE_COMPRESSION=true

# Performance Benchmarking
BENCH_DURATION=30
BENCH_CONNECTIONS=50
BENCH_PIPELINING=1
BASE_URL=http://localhost:5001

# Lighthouse Testing
# Comma-separated list of valid policy IDs for load testing
POLICY_IDS=507f1f77bcf86cd799439011,507f1f77bcf86cd799439012

# ============================================
# FILE UPLOAD
# ============================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ============================================
# FRONTEND
# ============================================
FRONTEND_URL=http://localhost:3000
# Database
MONGO_URI=mongodb://localhost:27017/insuremithra
MONGODB_URI=mongodb://localhost:27017/insuremithra
DB_NAME=insuremithra

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Server
PORT=5001
NODE_ENV=development

# Email (for password reset)
## Primary SMTP settings (Gmail) — ensure app password or proper access configured
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=insuremithra.pes@gmail.com
SMTP_PASS=vacq hytu ovfm ykwo

## Backwards-compatible EMAIL_* names (some code uses these)
EMAIL_HOST=${SMTP_HOST}
EMAIL_PORT=${SMTP_PORT}
EMAIL_USER=${SMTP_USER}
EMAIL_PASS=${SMTP_PASS}
EMAIL_FROM=InsureMithra <no-reply@insuremithra.com>
FROM_EMAIL=InsureMithra <no-reply@insuremithra.com>

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5
